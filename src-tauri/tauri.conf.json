{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autumn-natter",
  "version": "0.1.0",
  "identifier": "app.autumn.natter",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Autumn Natter",
        "width": 1180,
        "height": 760,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
