// Row structures that the Rust code passes to the UI.

// One entry of the model selector.
export struct ModelRow {
    id: string,
    name: string,
    kind: string,
    active: bool,
}

// One entry of the repository selector.
export struct RepoRow {
    id: string,
    name: string,
    path: string,
}

// One chat of the carousel.
export struct ChatRow {
    id: string,
    title: string,
    repo: string,
    when: string,
    active: bool,
    // Start of the newest message, for the soft picture at the side.
    preview: string,
}

// One block of rendered markdown inside a message.
export struct MarkdownBlock {
    kind: string,
    level: int,
    content: string,
}

// One message between the user and the model, or one tool result.
export struct MessageRow {
    id: string,
    role: string,
    body: string,
    tool: string,
    mono: bool,
    failed: bool,
    when: string,
    blocks: [MarkdownBlock],
}

// One graphics device of the system.
export struct GpuRow {
    id: int,
    name: string,
    memory: string,
    enabled: bool,
}
