// Main window of Autumn Natter.
// The Rust code in src/ui_app.rs owns the state and drives these properties.
import { Theme } from "theme.slint";
import { ModelRow, RepoRow, ChatRow, MessageRow } from "types.slint";
import { Badge, IconButton, Pill } from "widgets.slint";
// The two dialogs live in their own files.
export { ModelConfigWindow } from "model_config.slint";
export { SettingsWindow } from "settings.slint";
// The Rust code sets the palette through this global.
export { Theme } from "theme.slint";
import { ListView, Spinner, TextEdit } from "std-widgets.slint";

export component App inherits Window {
    title: "Autumn Natter";
    width: 1020px;
    height: 720px;
    background: Theme.bg;
    default-font-size: 14px;

    // ---- state that the Rust code sets ----
    in property <string> model-name: "";
    in property <string> model-kind: "";
    in property <bool> in-repository: false;
    in property <string> repository-name: "";
    in property <string> chat-title: "";
    in property <string> context-used: "0";
    in property <string> context-total: "0";
    in property <float> context-ratio: 0;
    in property <bool> generating: false;
    in property <bool> code-enabled: false;
    in property <bool> sandbox-enabled: true;
    in property <bool> sandbox-available: true;
    // The Rust code hides the chat list when it sets this to false.
    in property <bool> chat-open: true;

    // The Rust code raises this number when a message is added, so the newest
    // message is scrolled into view.
    in property <int> message-rev: 0;
    in property <bool> server-busy: false;
    in property <string> status-text: "";
    in property <[ModelRow]> models;
    in property <[RepoRow]> repositories;
    in property <[ChatRow]> chats;
    in property <[MessageRow]> messages;

    // The native build always shows the send button. The browser build shows it
    // only on a touch screen.
    in property <bool> send-visible: true;

    // Text inside the composer.
    in-out property <string> draft-text;

    // ---- actions ----
    callback send-message(text: string);
    callback cancel-generation();
    callback toggle-code(enabled: bool);
    callback toggle-sandbox(enabled: bool);
    callback open-settings();
    callback select-model(id: string);
    callback configure-model(id: string);
    callback select-repository(id: string);
    callback view-all-repositories();
    callback new-chat();
    callback open-chat(id: string);

    // Keep the newest message in view. The Rust code raises the number when a
    // message is added or when the model writes more text.
    changed message-rev => {
        chat-list.content-y = Math.min(0px, chat-list.height - chat-list.content-height);
    }

    VerticalLayout {
        spacing: 0;

        // ------------------------------------------------------------------
        // Top bar. It has the same colour as the chat window background.
        Rectangle {
            height: 48px;
            background: Theme.bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                // Program icon and program name.
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/autumn-natter.svg");
                        width: 24px;
                        height: 24px;
                        image-fit: contain;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Autumn Natter";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // Model selector.
                model-btn := Rectangle {
                    height: 32px;
                    width: model-label.preferred-width + kind-pill.preferred-width + 44px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: model-pop.is-open ? Theme.accent : Theme.line;
                    background: model-btn-area.has-hover ? Theme.hover : Theme.surface;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("../assets/icons/model.svg");
                            colorize: Theme.accent-warm;
                            width: 15px;
                            height: 15px;
                            vertical-alignment: center;
                        }
                        model-label := Text {
                            text: model-name != "" ? model-name : "No model";
                            color: model-name != "" ? Theme.text : Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        kind-pill := Pill {
                            text: model-kind;
                            visible: model-kind != "";
                        }
                        Image {
                            source: @image-url("../assets/icons/chevron-down.svg");
                            colorize: Theme.text-dim;
                            width: 14px;
                            height: 14px;
                            vertical-alignment: center;
                        }
                    }

                    model-btn-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { model-pop.show(); }
                    }

                    model-pop := PopupWindow {
                        x: 0;
                        y: 36px;
                        width: 380px;
                        height: 40px * models.length + 16px;
                        close-policy: close-on-click-outside;

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.surface;

                            ListView {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;

                                for m in models: Rectangle {
                                    width: parent.width;
                                    height: 40px;
                                    background: row-area.has-hover ? Theme.hover : transparent;

                                    HorizontalLayout {
                                        x: 10px;
                                        y: 0;
                                        width: parent.width - 56px;
                                        height: 100%;
                                        spacing: 8px;

                                        Text {
                                            text: m.name;
                                            color: m.active ? Theme.accent-strong : Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Pill {
                                            text: m.kind;
                                        }
                                    }

                                    // The row area stops before the gear button.
                                    row-area := TouchArea {
                                        width: parent.width - 46px;
                                        height: 100%;
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.select-model(m.id);
                                            model-pop.close();
                                        }
                                    }

                                    IconButton {
                                        x: parent.width - 40px;
                                        y: 5px;
                                        icon: @image-url("../assets/icons/settings.svg");
                                        tip: "Configure this model";
                                        selected: m.active;
                                        clicked => {
                                            root.configure-model(m.id);
                                            model-pop.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Repository selector. It is only there for a chat inside a repository.
                repo-btn := Rectangle {
                    height: 32px;
                    width: repo-label.preferred-width + 58px;
                    visible: in-repository;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: repo-pop.is-open ? Theme.accent : Theme.line;
                    background: repo-area.has-hover ? Theme.hover : Theme.surface;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 8px;
                        spacing: 7px;

                        Image {
                            source: @image-url("../assets/icons/folder.svg");
                            colorize: Theme.accent-warm;
                            width: 15px;
                            height: 15px;
                            vertical-alignment: center;
                        }
                        repo-label := Text {
                            text: repository-name;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Image {
                            source: @image-url("../assets/icons/chevron-down.svg");
                            colorize: Theme.text-dim;
                            width: 14px;
                            height: 14px;
                            vertical-alignment: center;
                        }
                    }

                    repo-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { repo-pop.show(); }
                    }

                    repo-pop := PopupWindow {
                        x: 0;
                        y: 36px;
                        width: 300px;
                        height: 38px * (repositories.length + 1) + 54px;
                        close-policy: close-on-click-outside;

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.surface;

                            VerticalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 0;

                                // Leave the repository and go back to the loose
                                // chats of this machine.
                                Rectangle {
                                    height: 38px;
                                    background: none-area.has-hover ? Theme.hover : transparent;

                                    Text {
                                        text: "No repository";
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        x: 12px;
                                        vertical-alignment: center;
                                    }
                                    none-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.select-repository("");
                                            repo-pop.close();
                                        }
                                    }
                                }

                                for r in repositories: Rectangle {
                                    height: 38px;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Image {
                                            source: @image-url("../assets/icons/folder.svg");
                                            colorize: Theme.text-dim;
                                            width: 15px;
                                            height: 15px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: r.name;
                                            color: r.name == repository-name ? Theme.accent-strong : Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.select-repository(r.id);
                                            repo-pop.close();
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    background: all-area.has-hover ? Theme.hover : transparent;

                                    Text {
                                        text: "View all repositories";
                                        color: Theme.accent-strong;
                                        font-size: 13px;
                                        x: 12px;
                                        vertical-alignment: center;
                                    }
                                    all-area := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.view-all-repositories();
                                            repo-pop.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Chat name. It comes from the first prompt of the user.
                Text {
                    text: chat-title;
                    color: Theme.text-dim;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Context display: used tokens over the token limit.
                Rectangle {
                    width: ctx.preferred-width + 12px;
                    height: 32px;

                    HorizontalLayout {
                        spacing: 6px;

                        ctx := Text {
                            text: context-used + " / " + context-total;
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: 30px;
                        x: 6px;
                        width: parent.width - 12px;
                        height: 2px;
                            border-radius: 1px;
                        background: Theme.line;

                        Rectangle {
                            width: parent.width * Math.min(1.0, Math.max(0.0, context-ratio));
                            height: 100%;
                            background: context-ratio > 0.9 ? Theme.accent-deep : Theme.accent;
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        HorizontalLayout {
            spacing: 0;

            // Chat list.
            Rectangle {
                width: 210px;
                visible: chat-open;
                background: Theme.surface;

                // Hairline between the chat list and the chat column.
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.line;
                }

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: new-area.has-hover ? Theme.tint : Theme.surface-alt;

                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 8px;

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                colorize: Theme.accent-strong;
                                width: 15px;
                                height: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "New chat";
                                color: Theme.accent-strong;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        new-area := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.new-chat(); }
                        }
                    }

                    chats-list := ListView {

                        for c in chats: Rectangle {
                            width: chats-list.width;
                            height: 46px;
                            border-radius: 8px;
                            background: c.active ? Theme.tint : (row.has-hover ? Theme.hover : transparent);

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 2px;

                                Text {
                                    text: c.title;
                                    color: c.active ? Theme.accent-strong : Theme.text;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: c.repo != "" ? c.repo : "no repository";
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: c.when;
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            row := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-chat(c.id); }
                            }
                        }
                    }
                }
            }

        // Chat column: messages, status line, composer.
            VerticalLayout {
                spacing: 0;

                chat-list := ListView {

                    for msg in messages: Rectangle {
                        width: chat-list.width;
                        height: 34px + head.preferred-height + body.preferred-height
                            + tool-box.height + (msg.tool != "" ? 10px : 0px);

                        Rectangle {
                            x: 8px;
                            y: 4px;
                            width: parent.width - 16px;
                            height: parent.height - 8px;
                            border-radius: 12px;
                            border-width: msg.failed ? 1px : 0px;
                            border-color: Theme.danger;
                            background: msg.role == "You" ? Theme.bubble-user : Theme.bubble-assistant;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;

                                head := HorizontalLayout {
                                    spacing: 8px;
                                    height: 16px;

                                    Text {
                                        text: msg.role;
                                        color: msg.role == "You" ? Theme.accent-strong : Theme.accent-leaf;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: msg.when;
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                body := Text {
                                    text: msg.body;
                                    color: msg.failed ? Theme.danger : Theme.text;
                                    font-size: 13.5px;
                                    wrap: word-wrap;
                                    width: parent.width;
                                }

                                tool-box := Rectangle {
                                    visible: msg.tool != "";
                                    width: parent.width;
                                    height: msg.tool != "" ? tool-text.preferred-height + 16px : 0px;
                                    border-radius: 8px;
                                    background: Theme.surface-alt;

                                    tool-text := Text {
                                        x: 8px;
                                        y: 8px;
                                        width: parent.width - 16px;
                                        text: msg.tool;
                                        color: msg.failed ? Theme.danger : Theme.text-dim;
                                        font-size: 12px;
                                        font-family: "monospace";
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // Status line.
                Rectangle {
                    height: 24px;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Spinner {
                            width: 14px;
                            height: 14px;
                            visible: server-busy;
                        }
                        Text {
                            text: status-text;
                            color: Theme.text-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Composer. The box keeps a fixed distance from both window sides.
                Rectangle {
                    height: 116px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 14px;
                        spacing: 8px;
                        // The composer box and the settings button sit on the bottom line.
                        cross-axis-alignment: end;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 94px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: draft.has-focus ? Theme.accent : Theme.line;
                            background: Theme.surface;

                            draft := TextEdit {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                height: parent.height - 48px;
                                font-size: 13.5px;
                                wrap: word-wrap;
                                placeholder-text: "Write a message. Enter sends the message.";
                                text <=> root.draft-text;
                                key-pressed(event) => {
                                    if (event.text == Key.Return) {
                                        if (event.modifiers.shift) {
                                            return EventResult.reject;
                                        }
                                        if (root.generating) {
                                            root.cancel-generation();
                                        } else if (root.draft-text != "") {
                                            root.send-message(root.draft-text);
                                        }
                                        return EventResult.accept;
                                    }
                                    return EventResult.reject;
                                }
                            }

                            // Badges in the lower left corner of the box.
                            HorizontalLayout {
                                x: 8px;
                                y: parent.height - 34px;
                                spacing: 8px;

                                Badge {
                                    text: "Code";
                                    icon: @image-url("../assets/icons/code.svg");
                                    active: code-enabled;
                                    tip: "Let the model run one terminal command per step. Every command runs in the sandbox when the sandbox is on.";
                                    clicked => { root.toggle-code(!code-enabled); }
                                }
                                Badge {
                                    text: "Sandbox";
                                    icon: @image-url("../assets/icons/shield.svg");
                                    active: sandbox-enabled;
                                    enabled: sandbox-available;
                                    tip: sandbox-available
                                        ? "Run every terminal command inside a bubblewrap sandbox. Inside a repository, the commands start in the repository directory."
                                        : "bubblewrap (bwrap) was not found. Install it to sandbox the terminal tool.";
                                    clicked => { root.toggle-sandbox(!sandbox-enabled); }
                                }
                            }

                            // Send button in the lower right corner of the box.
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                x: parent.width - 40px;
                                y: parent.height - 40px;
                                visible: send-visible;
                                border-radius: 16px;
                                background: send-area.has-hover
                                    ? (generating ? Theme.accent-deep : Theme.accent-warm)
                                    : (generating ? Theme.accent-strong : Theme.accent);

                                Image {
                                    source: generating
                                        ? @image-url("../assets/icons/stop.svg")
                                        : @image-url("../assets/icons/send.svg");
                                    colorize: Theme.on-accent;
                                    width: 16px;
                                    height: 16px;
                                    x: 8px;
                                    y: 8px;
                                }

                                send-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        if (generating) {
                                            root.cancel-generation();
                                        } else if (root.draft-text != "") {
                                            root.send-message(root.draft-text);
                                        }
                                    }
                                }
                            }
                        }

                        // Settings button, next to the chat box.
                        IconButton {
                            icon: @image-url("../assets/icons/settings.svg");
                            tip: "Settings";
                            glyph: Theme.text;
                            base: Theme.surface;
                            width: 32px;
                            height: 32px;
                            clicked => { root.open-settings(); }
                        }
                    }
                }
            }
        }
    }

}
