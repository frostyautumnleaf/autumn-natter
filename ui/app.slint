// Main window of Autumn Natter.
// The Rust code in src/ui_app.rs owns the state and drives these properties.
//
// The chats sit in a carousel. The card in the middle of the window is the chat
// the user works in. The next chats of the same place show a strip of
// themselves at each side, pale and soft. Every repository has a carousel of
// its own, and the chats with no repository have one of their own.
//
// Three more screens sit on top of the same state:
//
// * With no chat open, the chat box stands in the middle of the window, with
//   the program mark and a line for this hour above it. The first message
//   grows a chat from the top down and slides the box back to the bottom.
// * The Alt key turns the chats into a row of small previews. One click on a
//   preview opens that chat. Arrows, WASD, a drag, a flick and the wheel move
//   along the row, and a flick keeps gliding until it settles on a chat.
//
// Two notes on the keys. Slint 1.18 has no accept-return property, and a
// multi-line text input puts a newline on Enter, so the keys live on the text
// input itself, where they are read before the text input sees them. Slint has
// no event for a bare modifier key, but it sends the Alt key as the key text
// Key.Alt, so that is what brings the row of previews up.
//
// One note on layouts. A Slint layout keeps the room of an element whose
// visible property is false, which leaves a hole where the element stood. Every
// part that comes and goes therefore stands behind an if, and never behind a
// visible flag.

import { Theme } from "theme.slint";
import { ModelRow, RepoRow, ChatRow, MessageRow, MarkdownBlock } from "types.slint";
// The list of messages comes from the widget set of Slint. Its own scroll bar
// is switched off, because the program draws a thin one in the palette.
import { ListView } from "std-widgets.slint";
import {
    Badge,
    IconButton,
    Pill,
    TipLayer,
    ToolTipLayer,
} from "widgets.slint";
// The two dialogs live in their own files.
export { ModelConfigWindow } from "model_config.slint";
export { SettingsWindow } from "settings.slint";
// The Rust code sets the palette through this global.
export { Theme } from "theme.slint";

component Dot inherits Rectangle {
    in property <bool> lit: false;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background: Theme.accent-warm;
    opacity: lit ? 1 : 0.28;
    animate opacity { duration: 200ms; }
}

// A small mark that says the machine is working. Three dots light up one after
// the other. The Spinner of the widget set is not used, because its grey does
// not sit well on the palette of this program.
component BusyMark inherits Rectangle {
    in property <bool> running: true;
    property <int> step: 0;

    width: 20px;
    height: 8px;

    Dot {
        x: 0px;
        y: 2px;
        lit: running && step == 0;
    }
    Dot {
        x: 7px;
        y: 2px;
        lit: running && step == 1;
    }
    Dot {
        x: 14px;
        y: 2px;
        lit: running && step == 2;
    }

    pulse := Timer {
        interval: 260ms;
        running: root.running;
        triggered => {
            root.step = Math.mod(root.step + 1, 3);
        }
    }
}

// One block of rendered markdown. The kind of the block decides the shape.
//
// A hidden copy of the words stands behind every kind, so the height of the
// block is right whether the words are heading, list, code or plain. The block
// is used inside a layout, and a layout asks for the height of the whole block.
component MdBlock inherits Rectangle {
    in property <MarkdownBlock> md;
    // Colour of the words of this block.
    in property <color> ink: Theme.text;
    // A command and its output use a font of fixed width, so a plain block of
    // such a message keeps that font too.
    in property <bool> mono: false;

    // The room the words take at each side, which differs per kind. The hidden
    // text and the words that are drawn must have the same width, or the height
    // of the block does not match the lines that are shown.
    property <length> inset: md.kind == "text" ? 0px : 11px;
    property <length> size: md.kind == "heading"
        ? 15px
        : (md.kind == "code" || mono ? 12.5px : 13.5px);
    // Code sits on a panel, which has room of its own above and below.
    property <length> extra: md.kind == "code" ? 18px : 0px;

    // The width comes from the layout or the place this stands in.
    height: measure.preferred-height + extra;

    measure := Text {
        x: inset;
        y: 0px;
        width: parent.width - inset * 2;
        text: md.content;
        font-size: size;
        font-weight: md.kind == "heading" ? 700 : 400;
        font-family: md.kind == "code" || mono ? "monospace" : "";
        wrap: word-wrap;
        opacity: 0;
    }

    // A heading stands out with a short bar of colour at its left.
    if md.kind == "heading": Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        bar := Rectangle {
            x: 0px;
            y: 3px;
            width: 3px;
            height: parent.height - 6px;
            border-radius: 2px;
            background: Theme.accent;
        }
        Text {
            x: 11px;
            y: 0px;
            width: parent.width - 22px;
            text: md.content;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
        }
    }

    // A list keeps its own marks, and stands under a thin rule of colour.
    if md.kind == "list": Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        rule := Rectangle {
            x: 0px;
            y: 2px;
            width: 2px;
            height: parent.height - 4px;
            border-radius: 1px;
            background: Theme.line-strong;
        }
        Text {
            x: 11px;
            y: 0px;
            width: parent.width - 22px;
            text: md.content;
            color: ink;
            font-size: 13.5px;
            wrap: word-wrap;
        }
    }

    // Code stands on a panel of its own, in a font of fixed width.
    if md.kind == "code": Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.code-bg;
        Text {
            x: 11px;
            y: 9px;
            width: parent.width - 22px;
            text: md.content;
            color: Theme.text;
            font-size: 12.5px;
            font-family: "monospace";
            wrap: word-wrap;
        }
    }

    // Plain words need nothing around them.
    if md.kind != "heading" && md.kind != "list" && md.kind != "code": Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: md.content;
        color: ink;
        font-size: size;
        font-family: mono ? "monospace" : "";
        wrap: word-wrap;
    }
}

// What the model thought before it answered. It is set apart by a rule of
// colour and by softer words.
component ThinkingPanel inherits Rectangle {
    in property <string> body;
    in property <bool> live: false;

    // The width comes from the layout or the place this stands in.
    height: body != "" ? thought.preferred-height + (live ? 26px : 22px) : 0px;
    border-radius: 10px;
    background: Theme.think-bg;

    rule := Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-top-left-radius: 3px;
        border-bottom-left-radius: 3px;
        background: Theme.accent-leaf;
    }
    head := HorizontalLayout {
        x: 13px;
        y: 8px;
        spacing: 6px;
        cross-axis-alignment: center;
        Text {
            text: "Thinking";
            color: Theme.accent-leaf;
            font-size: 11px;
            font-weight: 600;
        }
        BusyMark {
            visible: live;
            width: 20px;
            height: 8px;
        }
    }
    thought := Text {
        x: 13px;
        y: 26px;
        width: parent.width - 26px;
        text: body;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// The output of one run of the terminal tool. The command itself stands in the
// body of the message, and the output comes in this panel.
component ToolPanel inherits Rectangle {
    in property <string> output;
    in property <bool> running: false;
    in property <bool> failed: false;

    // The width comes from the layout or the place this stands in.
    height: out-text.preferred-height + 40px;
    border-radius: 10px;
    border-width: failed ? 1px : 0px;
    border-color: Theme.danger;
    background: Theme.code-bg;

    head := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 24px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        background: Theme.code-head;

        Image {
            source: @image-url("../assets/icons/terminal.svg");
            colorize: failed ? Theme.danger : Theme.text-dim;
            width: 13px;
            height: 13px;
            x: 11px;
            y: 6px;
        }
        Text {
            x: 30px;
            y: 0px;
            text: "Terminal";
            color: failed ? Theme.danger : Theme.text-dim;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        // A run that has not finished says so at the right of the panel.
        Text {
            visible: running;
            x: parent.width - 120px;
            y: 0px;
            width: 108px;
            text: "running ...";
            color: Theme.text-dim;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    out-text := Text {
        x: 12px;
        y: 30px;
        width: parent.width - 24px;
        text: output;
        color: failed ? Theme.danger : Theme.text-dim;
        font-size: 12px;
        font-family: "monospace";
        wrap: word-wrap;
    }
}

// The soft picture of a chat that is not in the middle of the carousel. Only a
// strip of it is ever seen, so what matters stands at the edge that faces the
// middle of the window.
//
// Slint has no blur for the software renderer. The soft look is made by drawing
// the words twice, one hair apart, and by keeping the whole card pale. A wash of
// the window colour then fades the outer edge.
component GhostChat inherits Rectangle {
    in property <ChatRow> chat;
    // True when this card stands to the left of the middle, so its right edge
    // is the part that shows.
    in property <bool> on-left: false;

    // The title, held against the edge that faces the middle.
    Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: 17px;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            text: chat.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: on-left ? right : left;
        }
        // The same words a hair to the right and down, which softens the edges.
        Text {
            x: 1px;
            y: 1px;
            width: parent.width;
            text: chat.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: on-left ? right : left;
            opacity: 0.4;
        }
    }

    // Two lines of the newest message, kept short on purpose.
    Rectangle {
        x: 14px;
        y: 40px;
        width: parent.width - 28px;
        height: 44px;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            text: chat.preview;
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: on-left ? right : left;
            vertical-alignment: top;
        }
        Text {
            x: 1px;
            y: 1px;
            width: parent.width;
            text: chat.preview;
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: on-left ? right : left;
            vertical-alignment: top;
            opacity: 0.4;
        }
    }

    // Three pale bars, where the bubbles of that chat stand.
    Rectangle {
        y: parent.height - 156px;
        x: 14px;
        width: parent.width * 0.62;
        height: 46px;
        border-radius: 12px;
        background: Theme.bubble-ai;
    }
    Rectangle {
        y: parent.height - 100px;
        x: parent.width * 0.32;
        width: parent.width * 0.54;
        height: 34px;
        border-radius: 12px;
        background: Theme.bubble-user;
    }
    Rectangle {
        y: parent.height - 56px;
        x: 14px;
        width: parent.width * 0.72;
        height: 22px;
        border-radius: 10px;
        background: Theme.bubble-ai;
    }
    Rectangle {
        y: parent.height - 24px;
        x: 14px;
        width: parent.width * 0.38;
        height: 12px;
        border-radius: 6px;
        background: Theme.line;
    }
}

// One small card of the row that the Alt key brings up.
component ChatPreview inherits Rectangle {
    in property <ChatRow> chat;
    // True for the card in the middle of the row, which is the chat in use.
    in property <bool> middle: false;

    border-radius: 14px;
    border-width: middle ? 2px : 1px;
    border-color: middle ? Theme.accent : Theme.line;
    background: Theme.surface;
    // The neighbours stay back a little.
    opacity: middle ? 1 : 0.7;

    // A thin bar across the top of the card in use.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 3px;
        visible: middle;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        background: Theme.accent;
    }

    Text {
        x: 14px;
        y: 18px;
        width: parent.width - 28px;
        text: chat.title;
        color: Theme.text;
        font-size: 13.5px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 14px;
        y: 42px;
        width: parent.width - 28px;
        height: parent.height - 112px;
        text: chat.preview;
        color: Theme.text-dim;
        font-size: 12px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }
    Text {
        x: 14px;
        y: parent.height - 62px;
        width: parent.width - 28px;
        text: chat.repo;
        color: Theme.accent-leaf;
        font-size: 11px;
        overflow: elide;
    }
    Rectangle {
        x: 14px;
        y: parent.height - 44px;
        width: parent.width - 28px;
        height: 1px;
        background: Theme.line;
    }
    Text {
        x: 14px;
        y: parent.height - 30px;
        width: parent.width - 28px;
        text: chat.when;
        color: Theme.text-dim;
        font-size: 11px;
        opacity: 0.9;
        overflow: elide;
    }
}

// The list of messages of one chat, with a scroll bar of its own.
component MessageList inherits Rectangle {
    in property <[MessageRow]> messages;
    // True when the chat holds no message at all.
    in property <bool> blank: false;
    // The Rust code raises this number when a message is added or grows.
    in property <int> message-rev: 0;
    // True while an answer comes in.
    in property <bool> generating: false;

    list := ListView {
        x: 0px;
        y: 0px;
        width: parent.width - 14px;
        height: parent.height;
        // The scroll bar of the widget set does not follow the palette, so the
        // program draws a thin one at the right of the list.
        vertical-scrollbar-policy: always-off;

        for msg in messages: Rectangle {
            width: list.width;
            height: msg.role == "Note"
                ? note.preferred-height + 22px
                : talk.height + 18px;

            // A note from the program stands on its own, in the middle, with no
            // bubble around it.
            note := Text {
                visible: msg.role == "Note";
                x: 34px;
                y: 8px;
                width: parent.width - 68px;
                text: msg.body;
                color: msg.failed ? Theme.danger : Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }

            talk := Rectangle {
                visible: msg.role != "Note";
                x: 0px;
                y: 6px;
                width: parent.width;
                height: bubble.preferred-height;

                bubble := Rectangle {
                    x: msg.role == "You" ? (parent.width - self.width) : 0px;
                    width: parent.width * (msg.role == "You" ? 0.55 : 0.75);
                    height: inner.preferred-height + 24px;
                    border-width: 1px;
                    border-color: msg.failed
                        ? Theme.danger
                        : (msg.role == "You" ? Theme.bubble-user-line : Theme.bubble-ai-line);
                    background: msg.role == "You" ? Theme.bubble-user : Theme.bubble-ai;
                    // The top corner that looks inwards is cut less than the
                    // others, which shows at a glance who spoke.
                    border-top-left-radius: msg.role == "You" ? 14px : 4px;
                    border-top-right-radius: msg.role == "You" ? 4px : 14px;
                    border-bottom-left-radius: 14px;
                    border-bottom-right-radius: 14px;

                    inner := VerticalLayout {
                        x: 14px;
                        y: 12px;
                        width: parent.width - 28px;
                        height: parent.height - 24px;
                        spacing: 8px;

                        // Who is speaking. The words of the user need no label,
                        // because their bubble has its own colour and side. A
                        // tool run is labelled by the head of its own panel.
                        if msg.role == "Assistant": Text {
                            text: "Assistant";
                            color: Theme.accent-leaf;
                            font-size: 11px;
                            font-weight: 600;
                        }

                        // The words of the user.
                        if msg.role == "You": Rectangle {
                            width: parent.width;
                            height: user-blocks.preferred-height;
                            user-blocks := VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                spacing: 6px;
                                for block in msg.blocks: MdBlock {
                                    md: block;
                                    ink: msg.failed ? Theme.danger : Theme.text;
                                }
                            }
                        }

                        if msg.reasoning != "": ThinkingPanel {
                            body: msg.reasoning;
                            live: root.generating && msg.role == "Assistant";
                        }

                        // The answer of the model, and the command of a tool
                        // run, which stands in a font of fixed width.
                        if msg.role != "You": Rectangle {
                            width: parent.width;
                            height: ai-blocks.preferred-height;
                            ai-blocks := VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                spacing: 6px;
                                for block in msg.blocks: MdBlock {
                                    md: block;
                                    mono: msg.role == "Tool";
                                    ink: msg.failed ? Theme.danger : Theme.text;
                                }
                            }
                        }

                        // The output of one run of the terminal tool. A run that
                        // has no output yet keeps the panel, so the wait shows.
                        if msg.role == "Tool" && msg.tool != "": ToolPanel {
                            output: msg.tool;
                            running: msg.tool == "running ...";
                            failed: msg.failed;
                        }
                    }

                    // The pointer over a bubble brings its time up.
                    hover-area := TouchArea {
                        width: parent.width;
                        height: parent.height;
                    }
                }

                // The time of the message stands in the open space beside the
                // bubble, so it never pushes the words about.
                Text {
                    x: msg.role == "You"
                        ? 4px
                        : bubble.x + bubble.width + 14px;
                    y: 2px;
                    width: parent.width - bubble.width - 22px;
                    text: msg.when;
                    color: Theme.text-dim;
                    font-size: 11px;
                    horizontal-alignment: msg.role == "You" ? right : left;
                    opacity: hover-area.has-hover ? 1 : 0;
                    animate opacity { duration: 180ms; }
                }
            }
        }
    }

    // Keep the newest message in view. The list has no scroll-to function, so
    // the place of the content is set by hand.
    changed message-rev => {
        list.content-y = Math.min(0px, list.height - list.content-height);
    }
    // An answer grows while it is written, so the view follows the growth.
    property <length> follow: list.content-height;
    changed follow => {
        if (root.generating) {
            list.content-y = Math.min(0px, list.height - list.content-height);
        }
    }

    // A thin scroll bar, drawn in the palette of the program.
    track := Rectangle {
        visible: list.content-height > list.height + 1px;
        x: parent.width - 6px;
        y: 8px;
        width: 4px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: Theme.line;

        Rectangle {
            width: 4px;
            height: Math.max(26px, track.height * list.height / list.content-height);
            y: (track.height - self.height) * (-list.content-y)
                / Math.max(1px, list.content-height - list.height);
            border-radius: 2px;
            background: Theme.text-dim;
            opacity: 0.5;
        }
    }

    // A chat with nothing in it says what to do next.
    Text {
        visible: root.blank;
        x: 26px;
        y: 26px;
        width: parent.width - 52px;
        text: "Nothing written yet. Write below and press Enter. A chat with nothing in it goes away when you turn the carousel.";
        color: Theme.text-dim;
        font-size: 13px;
        wrap: word-wrap;
    }
}

// ----------------------------------------------------------------------
// The window.
export component App inherits Window {
    title: "Autumn Natter";
    // The Rust code sets the size of the window, so the window can be made
    // bigger or smaller by hand. Only the smallest size stands here.
    min-width: 560px;
    min-height: 440px;
    background: Theme.bg;
    default-font-size: 14px;
    // The chat box holds the keys as soon as the window is up, so Enter sends
    // and Alt brings the row of previews up without a click first.
    forward-focus: draft;

    // ------------------------------------------------------------------
    // State that the Rust code sets.
    in property <string> model-name: "";
    in property <string> model-kind: "";
    // The widest model name and the widest model kind of the list. The box in
    // the top bar takes this room, so a name is never cut down.
    in property <string> longest-model: "";
    in property <string> longest-kind: "";
    in property <bool> in-repository: false;
    in property <string> repository-name: "";
    in property <string> longest-repository: "";
    in property <string> chat-title: "";
    in property <string> context-used: "0";
    in property <string> context-total: "0";
    in property <float> context-ratio: 0;
    in property <bool> generating: false;
    in property <bool> code-enabled: false;
    in property <bool> sandbox-enabled: true;
    in property <bool> sandbox-available: true;
    // The thinking mode of the open chat.
    in property <string> thinking-mode: "auto";
    // True when the model's template can switch thinking.
    in property <bool> thinking-available: false;
    in property <bool> server-busy: false;
    in property <string> status-text: "";
    // True when the chat in the middle has no message yet.
    in property <bool> blank-chat: false;
    // True when no chat is open. The chat box then stands in the middle of the
    // window, with the program mark and a line for this hour above it.
    in property <bool> home: false;
    // True while the chats show as a row of small previews.
    in property <bool> overview: false;
    // The line above the chat box while no chat is open.
    in property <string> greeting: "";

    in property <[ModelRow]> models;
    in property <[RepoRow]> repositories;
    // The chats of this place, newest first. This list is the carousel.
    in property <[ChatRow]> chats;
    // Which chat of the carousel sits in the middle.
    in property <int> chat-index: 0;
    in property <[MessageRow]> messages;
    // The Rust code raises this number when a message is added or grows.
    in property <int> message-rev: 0;
    // True when the round send mark shows. Enter sends in any case.
    in property <bool> send-visible: false;
    // Text inside the chat box.
    in-out property <string> draft-text;

    // ------------------------------------------------------------------
    // Actions.
    callback send-message(text: string);
    callback cancel-generation();
    callback toggle-code(enabled: bool);
    callback toggle-sandbox(enabled: bool);
    // Turn the thinking mode to the next one the model offers.
    callback cycle-thinking();
    callback open-settings();
    callback select-model(id: string);
    callback configure-model(id: string);
    callback select-repository(id: string);
    callback view-all-repositories();
    callback new-chat();
    // Turn the carousel. Minus one shows the chat on the left, plus one the
    // chat on the right.
    callback roll-chat(step: int);
    // Put the row of previews up, or take it away again.
    callback show-overview();
    callback hide-overview();
    // Open one chat of the row of previews.
    callback pick-chat(id: string);

    // ------------------------------------------------------------------
    // Shape of the window. The chat card and the chat box below use the same x
    // and the same width, so the two always stand in line.
    out property <length> inset: 18px;
    // How much of a neighbour chat shows at each side.
    out property <length> peek: 58px;
    out property <length> card-gap: 16px;
    out property <length> bar-height: 52px;
    out property <length> status-height: 30px;
    // The chat box keeps a height of its own, so the row of badges always sits
    // well inside it.
    out property <length> box-height: 118px;
    out property <length> dock-height: status-height + 8px + box-height;
    // True when the window is narrow, so the top bar gives way in good order.
    out property <bool> tight: root.width < 860px;
    out property <length> card-x: inset + peek;
    out property <length> card-width: Math.max(280px, root.width - 2 * (inset + peek));
    out property <length> stage-top: bar-height + 12px;
    // The chat box stands in the middle of the window at home, and at the
    // bottom of the window when a chat is open.
    out property <length> dock-y: home
        ? (root.height - dock-height) / 2 + 26px
        : root.height - dock-height - 14px;
    out property <length> stage-height: Math.max(0px, dock-y - stage-top - 12px);
    out property <bool> can-roll-left: chat-index > 0;
    out property <bool> can-roll-right: chat-index < chats.length - 1;
    // A neighbour chat is put away when the chat in the middle has nothing in
    // it, or when there is one chat or none. An empty column at the side of the
    // window only confuses, and there is nothing to look at there.
    out property <bool> peek-hidden: blank-chat || chats.length < 2;
    // True when there is something to send.
    out property <bool> can-send: draft-text != "";

    // Room that the top bar spends on things other than the two selector boxes.
    out property <length> bar-fixed: 24px + 50px + (tight ? 72px : 116px)
        + (tight ? 0px : 168px) + (tight ? 26px : 140px);
    out property <length> chip-room: Math.max(180px, root.width - bar-fixed);
    out property <length> model-cap: Math.min(tight ? 190px : 320px, chip-room * 0.56);
    out property <length> repo-cap: Math.min(tight ? 140px : 230px, chip-room * 0.44);

    // Shape of the row of previews.
    out property <length> prev-width: Math.max(180px, Math.min(300px, (root.width - 40px) / 4.2));
    out property <length> prev-gap: 18px;
    out property <length> prev-step: prev-width + prev-gap;
    out property <length> prev-height: Math.min(prev-width * 1.24, stage.height - 78px);
    // Distance from the top of the stage to the row of previews. The row stands
    // in the middle of the room that is left for it.
    out property <length> prev-y: Math.max(8px, (stage.height - prev-height) / 2 - 14px);

    // ------------------------------------------------------------------
    // Motion of the row of previews. All of it runs from one short timer, so a
    // flick keeps gliding and then settles on a chat.
    // How far the row is pushed from its resting place.
    property <length> spin: 0px;
    // Where the row wants to rest.
    property <length> spin-target: 0px;
    // Speed of the row, in pixels for every tick.
    property <length> spin-speed: 0px;
    property <bool> dragging: false;
    // True once the pointer moved far enough to be a drag and not a click.
    property <bool> drag-moved: false;
    property <length> drag-from: 0px;
    property <length> mouse-from: 0px;
    property <length> mouse-last: 0px;
    // Speed of the last move of the pointer, which becomes the flick.
    property <length> flick: 0px;
    // Which preview the pointer went down on. Minus one for none.
    property <int> pressed-index: -1;
    // True while something still moves, so the timer is not left running.
    property <bool> moving: false;
    // The step the keys asked for. The row slides by one whole step and the
    // carousel turns when the slide is over, so the row never jumps. Zero means
    // that no key step waits.
    property <int> key-roll: 0;
    // Wheel turns that are not big enough for a step of their own yet.
    property <length> wheel-held: 0px;
    // 0 to 1 while the row settles after it came up.
    property <float> open-t: 1;
    // How much bigger a preview still is while the row settles. A Rectangle is
    // sized by hand here, because the software renderer has no transform for a
    // layer.
    out property <float> prev-scale: 1 + (1 - open-t) * 0.5;
    // 0 to 1 while a chat grows from the top down.
    property <float> turn: 1;
    // True while the program mark and the greeting line are on the screen.
    property <bool> greet-shown: false;
    // True for the short wait before the mark and the line fade away.
    property <bool> fade-pending: false;

    // Where preview number index stands inside the stage.
    function prev-x(index: int) -> length {
        return (stage.width - prev-width) / 2 + (index - chat-index) * prev-step - spin;
    }

    // Keeps a length inside two limits.
    function clamp-length(value: length, low: length, high: length) -> length {
        if (value < low) {
            return low;
        }
        if (value > high) {
            return high;
        }
        return value;
    }

    // The resting places of the row lie a whole number of steps apart. The
    // division by 1px turns a length into a plain number.
    function align(value: length) -> length {
        let step-units = prev-step / 1px;
        let whole = Math.round((value / 1px) / step-units);
        return whole * step-units * 1px;
    }

    // A turn of the carousel keeps the preview the pointer holds in its place.
    // A card stands at (index - chat-index) * step - spin, so a turn that moves
    // chat-index also moves spin the other way.
    function keep-place() {
        let half = prev-step / 2;
        if (spin >= half && can-roll-left) {
            root.roll-chat(-1);
            spin += prev-step;
            drag-from += prev-step;
        } else if (spin <= -half && can-roll-right) {
            root.roll-chat(1);
            spin -= prev-step;
            drag-from -= prev-step;
        }
    }

    // One step of the motion.
    function tick() {
        if (open-t < 1) {
            open-t = Math.min(1, open-t + 0.07);
        }
        if (dragging) {
            // The pointer decides where the row stands while it is held down.
            return;
        }
        // A step with the keys is a slide of one whole step. The carousel turns
        // when the slide is over, which keeps the row smooth.
        if (key-roll != 0) {
            let goal = key-roll * prev-step;
            let left = goal - spin;
            if (Math.abs(left) < 0.5px) {
                spin = 0px;
                let step = key-roll;
                key-roll = 0;
                root.roll-chat(step);
                return;
            }
            spin += left * 0.22;
            return;
        }
        let half = prev-step / 2;
        // A flick keeps gliding, and gives a little speed back each tick.
        if (Math.abs(spin-speed) > 0.4px) {
            spin += spin-speed;
            spin-speed *= 0.94;
            keep-place();
            return;
        }
        spin-speed = 0px;
        // At an end there is nothing to turn to, so the row eases back.
        let blocked = (spin >= half && !can-roll-left)
            || (spin <= -half && !can-roll-right);
        let rest = blocked ? 0px : spin-target;
        let gap = rest - spin;
        if (Math.abs(gap) < 0.5px) {
            spin = rest;
            if (open-t >= 1) {
                moving = false;
            }
            return;
        }
        spin += gap * 0.22;
    }

    // The preview that stands under this x.
    function preview-at(x: length) -> int {
        let step-units = prev-step / 1px;
        let left = (stage.width - prev-width) / 2 - spin;
        let offset = Math.round(((x - left) / 1px) / step-units);
        return Math.max(0, Math.min(chats.length - 1, chat-index + offset));
    }

    // The pointer went down on the row.
    function grab(x: length) {
        pressed-index = preview-at(x);
        drag-from = spin;
        mouse-from = x;
        mouse-last = x;
        flick = 0px;
        dragging = true;
        drag-moved = false;
        spin-speed = 0px;
        spin-target = spin;
        moving = true;
    }

    // The pointer moved while the row was held down.
    function drag-to(x: length) {
        if (!dragging) {
            return;
        }
        flick = x - mouse-last;
        mouse-last = x;
        if (Math.abs(x - mouse-from) > 4px) {
            drag-moved = true;
        }
        spin = drag-from + (x - mouse-from);
        spin-target = spin;
        keep-place();
    }

    // The pointer let go. A short press that did not move opens a chat.
    function release(x: length) {
        dragging = false;
        moving = true;
        if (!drag-moved && Math.abs(flick) < 1px) {
            if (pressed-index >= 0 && pressed-index < chats.length) {
                root.pick-chat(chats[pressed-index].id);
            }
            pressed-index = -1;
            spin-target = align(spin);
            return;
        }
        pressed-index = -1;
        // The speed of the last move becomes the speed of the flick.
        spin-speed = clamp-length(flick, -60px, 60px) * 0.6;
        spin-target = align(spin);
    }

    // The wheel moves along the row. The turns are kept until they add up to one
    // notch, and one notch is one chat. A slide that is still going waits for
    // the next notch, so a quick wheel cannot run past ten chats.
    function spin-by(delta: length) {
        if (key-roll != 0) {
            return;
        }
        wheel-held += delta;
        if (wheel-held >= 30px) {
            wheel-held -= 30px;
            move-one(1);
        } else if (wheel-held <= -30px) {
            wheel-held += 30px;
            move-one(-1);
        }
    }

    // One step with the keys. The row slides by one whole step, and the carousel
    // turns when the slide is over. A step is not made at an end of the row,
    // because there is nothing to turn to there.
    function move-one(step: int) {
        if (step == 0) {
            return;
        }
        if (step < 0 && !can-roll-left) {
            return;
        }
        if (step > 0 && !can-roll-right) {
            return;
        }
        spin-speed = 0px;
        key-roll = step;
        moving = true;
    }

    // Open the chat in the middle of the row.
    function pick-middle() {
        if (chat-index >= 0 && chat-index < chats.length) {
            root.pick-chat(chats[chat-index].id);
        }
    }

    // Ask for the row of previews, or put it away again.
    function ask-overview(on: bool) {
        if (on == root.overview) {
            return;
        }
        if (on) {
            root.show-overview();
        } else {
            root.hide-overview();
        }
    }

    // The row of previews, and the first chat, both start their motion here.
    changed overview => {
        if (root.overview) {
            open-t = 0;
            spin = 0px;
            spin-target = 0px;
            spin-speed = 0px;
            key-roll = 0;
            wheel-held = 0px;
            pressed-index = -1;
            moving = true;
            greet-shown = false;
            stage-keys.focus();
        } else {
            // The keys go back to the composer, where they are wanted next.
            draft.focus();
        }
    }

    // The mark and the greeting line stand only while no chat is open. The
    // first screen is asked for at once, so the value does not wait for a
    // change of the flag: a window that opens on a chat must not show them.
    init => {
        greet-shown = root.home;
    }

    changed home => {
        if (root.home) {
            greet-shown = true;
            fade-pending = false;
            turn = 1;
        } else {
            // The chat grows from the top down, and the mark and the line fade
            // after a short wait instead of popping away.
            turn = 0;
            fade-pending = true;
        }
    }

    // Motion of the row of previews.
    physics := Timer {
        interval: 16ms;
        running: root.overview && root.moving;
        triggered => { root.tick(); }
    }

    // The chat card grows from the top down after the first message. The run
    // rule may not ask whether a turn has begun, because the growth starts at
    // zero and zero would stop the timer again at once.
    grow := Timer {
        interval: 16ms;
        running: !root.home && root.turn < 1;
        triggered => { root.turn = Math.min(1, root.turn + 0.07); }
    }

    // The short wait before the mark and the greeting line fade away.
    fade := Timer {
        interval: 360ms;
        running: root.fade-pending;
        triggered => {
            greet-shown = false;
            fade-pending = false;
        }
    }

    // ------------------------------------------------------------------
    // Top bar. It keeps the colour of the window background, and a hairline at
    // its bottom, so the card below reads as a layer of its own. Nothing in
    // this bar may push another part out of the window: the wide parts have a
    // limit that follows the width of the window, and the chat name takes what
    // is left.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        background: Theme.bg;

        Rectangle {
            x: 0px;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            cross-axis-alignment: center;

            // Program mark, and the name of the program while there is room.
            Rectangle {
                width: root.tight ? 28px : 44px + mark-name.preferred-width;
                height: 34px;
                vertical-stretch: 0;

                Image {
                    source: @image-url("../assets/icons/autumn-natter.svg");
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                    x: 0px;
                    y: 3px;
                }
                mark-name := Text {
                    visible: !root.tight;
                    x: 38px;
                    y: 0px;
                    text: "Autumn Natter";
                    color: Theme.text;
                    font-size: 13.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Model selector. The box is as wide as the longest name in the
            // list with its kind behind it, so it shows a whole name and still
            // gives way when the window is small.
            model-btn := Rectangle {
                height: 34px;
                width: Math.min(root.model-cap, Math.max(118px, model-measure.preferred-width + 86px));
                horizontal-stretch: 0;
                border-radius: 9px;
                border-width: 1px;
                border-color: model-pop.is-open ? Theme.accent : Theme.line;
                background: model-btn-area.has-hover ? Theme.hover : Theme.surface;

                // Nobody reads this text. It only gives the room that the
                // longest name and the longest kind need together.
                model-measure := Text {
                    text: longest-model + "  " + longest-kind;
                    font-size: 13px;
                    x: 0px;
                    y: 0px;
                    opacity: 0;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 9px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/model.svg");
                        colorize: Theme.accent-warm;
                        width: 15px;
                        height: 15px;
                        vertical-alignment: center;
                    }
                    model-label := Text {
                        text: model-name != "" ? model-name : "No model";
                        color: model-name != "" ? Theme.text : Theme.text-dim;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Pill {
                        text: model-kind;
                        visible: model-kind != "";
                    }
                    Image {
                        source: @image-url("../assets/icons/chevron-down.svg");
                        colorize: Theme.text-dim;
                        width: 13px;
                        height: 13px;
                        vertical-alignment: center;
                    }
                }

                model-btn-area := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { model-pop.show(); }
                }

                model-pop := PopupWindow {
                    x: 0px;
                    y: 38px;
                    width: Math.min(420px, root.width - 24px);
                    // A long model list must not run past the window, so the
                    // list gets a top and scrolls inside.
                    height: Math.min(42px * models.length + 16px, root.height - 72px);
                    close-policy: close-on-click-outside;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.line-strong;
                        background: Theme.surface;

                        ListView {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            vertical-scrollbar-policy: always-off;

                            for m in models: Rectangle {
                                width: parent.width;
                                height: 42px;

                                Rectangle {
                                    x: 5px;
                                    y: 3px;
                                    width: parent.width - 10px;
                                    height: parent.height - 6px;
                                    border-radius: 8px;
                                    visible: m.active || model-row-area.has-hover;
                                    background: m.active ? Theme.tint : Theme.hover;
                                }

                                HorizontalLayout {
                                    x: 12px;
                                    y: 0px;
                                    width: parent.width - 60px;
                                    height: 100%;
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: m.name;
                                        color: m.active ? Theme.accent-strong : Theme.text;
                                        font-size: 13px;
                                        font-weight: m.active ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                    }
                                    Pill {
                                        text: m.kind;
                                    }
                                }

                                // The row area stops before the gear button.
                                model-row-area := TouchArea {
                                    width: parent.width - 46px;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.select-model(m.id);
                                        model-pop.close();
                                    }
                                }

                                IconButton {
                                    x: parent.width - 40px;
                                    y: 9px;
                                    icon: @image-url("../assets/icons/settings.svg");
                                    tip: "Configure this model";
                                    tip-left: true;
                                    selected: m.active;
                                    clicked => {
                                        root.configure-model(m.id);
                                        model-pop.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Repository selector. It shows which place the carousel belongs
            // to. The box follows the longest repository name, as the model box
            // follows the longest model name.
            repo-btn := Rectangle {
                height: 34px;
                visible: in-repository;
                width: Math.min(root.repo-cap, Math.max(104px, repo-measure.preferred-width + 66px));
                horizontal-stretch: 0;
                border-radius: 9px;
                border-width: 1px;
                border-color: repo-pop.is-open ? Theme.accent : Theme.line;
                background: repo-btn-area.has-hover ? Theme.hover : Theme.surface;

                repo-measure := Text {
                    text: longest-repository;
                    font-size: 13px;
                    x: 0px;
                    y: 0px;
                    opacity: 0;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 9px;
                    spacing: 7px;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/folder.svg");
                        colorize: Theme.accent-warm;
                        width: 15px;
                        height: 15px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: repository-name;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Image {
                        source: @image-url("../assets/icons/chevron-down.svg");
                        colorize: Theme.text-dim;
                        width: 13px;
                        height: 13px;
                        vertical-alignment: center;
                    }
                }

                repo-btn-area := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { repo-pop.show(); }
                }

                repo-pop := PopupWindow {
                    x: 0px;
                    y: 38px;
                    width: Math.min(320px, root.width - 24px);
                    // The list of repositories gets a top, so a short window
                    // still shows a list that fits.
                    height: Math.min(38px * (repositories.length + 2) + 16px, root.height - 72px);
                    close-policy: close-on-click-outside;

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.line-strong;
                        background: Theme.surface;

                        VerticalLayout {
                            padding: 6px;
                            spacing: 0;

                            // Leave the repository and go back to the loose
                            // chats of this machine.
                            Rectangle {
                                height: 38px;
                                background: none-area.has-hover ? Theme.hover : transparent;

                                Text {
                                    text: "No repository";
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    x: 12px;
                                    vertical-alignment: center;
                                }
                                none-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.select-repository("");
                                        repo-pop.close();
                                    }
                                }
                            }

                            for r in repositories: Rectangle {
                                height: 38px;
                                background: row-area.has-hover ? Theme.hover : transparent;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/folder.svg");
                                        colorize: r.name == repository-name ? Theme.accent-warm : Theme.text-dim;
                                        width: 15px;
                                        height: 15px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: r.name;
                                        color: r.name == repository-name ? Theme.accent-strong : Theme.text;
                                        font-size: 13px;
                                        font-weight: r.name == repository-name ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                    }
                                }

                                repo-row-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.select-repository(r.id);
                                        repo-pop.close();
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: all-area.has-hover ? Theme.hover : transparent;

                                Rectangle {
                                    x: 10px;
                                    y: 0px;
                                    width: parent.width - 20px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                                Text {
                                    text: "View all repositories";
                                    color: Theme.accent-strong;
                                    font-size: 13px;
                                    x: 12px;
                                    vertical-alignment: center;
                                }
                                all-area := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.view-all-repositories();
                                        repo-pop.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // The two marks that turn the carousel, with the place of this chat
            // between them. They stand together in one box, so it is clear that
            // they belong to the carousel and not to the bar.
            Rectangle {
                width: root.tight ? 66px : 118px;
                height: 34px;
                horizontal-stretch: 0;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.surface;

                IconButton {
                    x: 4px;
                    y: 5px;
                    width: 24px;
                    height: 24px;
                    glyph-size: 14px;
                    icon: @image-url("../assets/icons/left.svg");
                    tip: "Show the chat on the left";
                    enabled: can-roll-left;
                    clicked => { root.roll-chat(-1); }
                }
                Text {
                    x: 30px;
                    y: 0px;
                    width: parent.width - 62px;
                    text: (chat-index > 0 || chats.length > 1)
                        ? "\{chat-index + 1} of \{chats.length}" : "";
                    height: parent.height;
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    x: parent.width - 28px;
                    y: 5px;
                    width: 24px;
                    height: 24px;
                    glyph-size: 14px;
                    icon: @image-url("../assets/icons/right.svg");
                    tip: "Show the chat on the right";
                    enabled: can-roll-right;
                    clicked => { root.roll-chat(1); }
                }
            }

            // Chat name. It comes from the first prompt of the user. It is the
            // chief word of this bar, and it takes the room that is left.
            Text {
                text: chat-title;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // Context used, with a thin bar under the words. The bar turns dark
            // red when the window of the model is nearly full.
            Rectangle {
                width: Math.min(root.tight ? 150px : 232px, ctx.preferred-width + 18px);
                height: 34px;
                horizontal-stretch: 0;
                border-radius: 9px;
                border-width: 1px;
                border-color: context-ratio > 0.9 ? Theme.accent-deep : Theme.line;
                background: Theme.surface;

                ctx := Text {
                    text: root.tight
                        ? context-used + " / " + context-total
                        : context-used + " of " + context-total + " tokens";
                    color: Theme.text-dim;
                    font-size: 11.5px;
                    overflow: elide;
                    x: 9px;
                    y: 5px;
                    width: parent.width - 18px;
                }

                Rectangle {
                    x: 9px;
                    y: 24px;
                    width: parent.width - 18px;
                    height: 3px;
                    border-radius: 2px;
                    background: Theme.line;

                    Rectangle {
                        width: parent.width * Math.min(1.0, Math.max(0.0, context-ratio));
                        height: 100%;
                        border-radius: 2px;
                        background: context-ratio > 0.9 ? Theme.accent-deep : Theme.accent;
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // The carousel. The middle card is the chat in use. The chat card and the
    // chat box below use the same x and the same width, so they line up.
    stage := Rectangle {
        x: 0px;
        y: root.stage-top;
        width: root.width;
        height: root.stage-height;
        clip: true;

        // A chat is drawn when it sits in the middle or next to it, so a place
        // with many chats costs the same as a place with three.
        for c[index] in chats: Rectangle {
            out property <bool> near: Math.abs(index - chat-index) <= 1;
            visible: near && !root.overview && !root.peek-hidden;
            z: c.active ? 2 : 1;
            width: root.card-width;
            // The chat grows from the top down when the first message comes.
            height: root.home ? 0px : stage.height * root.turn;
            y: 0px;
            x: root.card-x + (index - chat-index) * (root.card-width + root.card-gap);
            // A turn of the carousel is a move, not a new card, so the slide
            // has an earlier value to come from.
            animate x { duration: 300ms; }
            animate opacity { duration: 300ms; }
            clip: true;
            border-radius: 16px;
            border-width: 1px;
            border-color: c.active ? Theme.accent-strong : Theme.line;
            background: Theme.surface;
            // A neighbour chat is pale, so it stays out of the way.
            opacity: c.active ? 1 : 0.4;

            if c.active: MessageList {
                x: 14px;
                y: 12px;
                width: parent.width - 28px;
                height: parent.height - 24px;
                messages: root.messages;
                blank: root.blank-chat;
                message-rev: root.message-rev;
                generating: root.generating;
            }

            if !c.active && near: GhostChat {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                chat: c;
                on-left: index < chat-index;
            }
        }

        // A wash of the window colour over each neighbour, so its outer edge
        // fades away, and a mark in the middle of the strip that says which way
        // the carousel turns.
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.card-x - root.card-gap;
            height: stage.height;
            visible: root.can-roll-left && !root.overview && !root.peek-hidden;
            background: @linear-gradient(90deg, Theme.bg, #00000000);

            Image {
                source: @image-url("../assets/icons/left.svg");
                colorize: Theme.accent-strong;
                width: 15px;
                height: 15px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                opacity: left-area.has-hover ? 0.95 : 0.3;
                animate opacity { duration: 160ms; }
            }
        }
        Rectangle {
            x: stage.width - (root.card-x - root.card-gap);
            y: 0px;
            width: root.card-x - root.card-gap;
            height: stage.height;
            visible: root.can-roll-right && !root.overview && !root.peek-hidden;
            background: @linear-gradient(270deg, Theme.bg, #00000000);

            Image {
                source: @image-url("../assets/icons/right.svg");
                colorize: Theme.accent-strong;
                width: 15px;
                height: 15px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                opacity: right-area.has-hover ? 0.95 : 0.3;
                animate opacity { duration: 160ms; }
            }
        }
        left-area := TouchArea {
            x: 0px;
            y: 0px;
            width: root.card-x - root.card-gap;
            height: stage.height;
            enabled: root.can-roll-left && !root.overview && !root.peek-hidden;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.roll-chat(-1); }
        }
        right-area := TouchArea {
            x: stage.width - (root.card-x - root.card-gap);
            y: 0px;
            width: root.card-x - root.card-gap;
            height: stage.height;
            enabled: root.can-roll-right && !root.overview && !root.peek-hidden;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.roll-chat(1); }
        }

        // The soft backdrop of the row of previews.
        Rectangle {
            visible: root.overview;
            x: 0px;
            y: 0px;
            width: stage.width;
            height: stage.height;
            z: 2;
            opacity: 0.94;
            background: Theme.bg;
        }

        // How many chats this place holds, above the row.
        Text {
            visible: root.overview;
            z: 3;
            x: 40px;
            y: root.prev-y - 32px;
            width: stage.width - 80px;
            text: chats.length == 0
                ? "This place holds no chat yet"
                : "\{chats.length} \{chats.length == 1 ? "chat" : "chats"} in \{in-repository ? repository-name : "the loose chats of this machine"}";
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }

        // A line that says what the keys and the pointer do here.
        Text {
            visible: root.overview;
            z: 3;
            x: 60px;
            y: root.prev-y + root.prev-height + 22px;
            width: stage.width - 120px;
            text: "Click a card to open it. Drag, arrows, WASD or the wheel move along the row. Escape or Alt puts the row away.";
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        // The row of previews. Only seven are drawn, about the chat in use, so
        // a place with many chats stays light to draw.
        row := Rectangle {
            visible: root.overview;
            x: 0px;
            y: 0px;
            width: stage.width;
            height: stage.height;
            z: 3;

            // Every preview is made bigger or smaller about its own middle
            // while the row settles. The width and the height carry the scale,
            // and x and y move back by half of what was added, so the middle of
            // the preview stays where it stands.
            for n in 7: Rectangle {
                property <int> i: root.chat-index + n - 3;
                visible: i >= 0 && i < root.chats.length;
                width: root.prev-width * root.prev-scale;
                height: root.prev-height * root.prev-scale;
                x: root.prev-x(i) + root.prev-width * (1 - root.prev-scale) / 2;
                y: root.prev-y + root.prev-height * (1 - root.prev-scale) / 2;
                opacity: root.open-t;

                ChatPreview {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    chat: root.chats[i];
                    middle: i == root.chat-index;
                }
            }
        }

        // The pointer moves along the row here. A press and a release without a
        // move opens the preview it stood on.
        row-area := TouchArea {
            visible: root.overview;
            z: 4;
            x: 0px;
            y: 0px;
            width: stage.width;
            height: stage.height;
            mouse-cursor: MouseCursor.pointer;

            // A TouchArea reports a change of its pressed property. It has no
            // pressed and released callback of its own.
            changed pressed => {
                if (row-area.pressed) {
                    root.grab(row-area.mouse-x);
                } else {
                    root.release(row-area.mouse-x);
                }
            }
            moved => { root.drag-to(row-area.mouse-x); }
            scroll-event(event) => {
                if (root.overview) {
                    root.spin-by(event.delta-y + event.delta-x);
                    return accept;
                }
                return reject;
            }
        }

        // The keys of the row. They work while the row is up, because the row
        // takes the focus from the chat box when it comes up.
        stage-keys := FocusScope {
            visible: root.overview;
            z: 5;
            focus-on-click: false;

            key-pressed(event) => {
                if (event.text == Key.Alt) {
                    root.ask-overview(false);
                    return accept;
                }
                return reject;
            }

            key-released(event) => {
                if (!root.overview) {
                    return reject;
                }
                if (event.text == Key.Escape) {
                    root.ask-overview(false);
                    return accept;
                }
                let key = event.text.to-lowercase();
                if (key == "a") {
                    root.move-one(-1);
                    return accept;
                }
                if (key == "d") {
                    root.move-one(1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.move-one(-1);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.move-one(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.pick-middle();
                    return accept;
                }
                return reject;
            }
        }
    }

    // ------------------------------------------------------------------
    // The first screen. The program mark and a line for this hour stand above
    // the chat box while no chat is open. They fade away when a chat opens or
    // when the previews come up, and they never stand over a chat.
    Rectangle {
        x: 0px;
        y: dock.y - 178px;
        width: root.width;
        height: 156px;
        visible: root.greet-shown;
        opacity: root.home && !root.overview ? 1 : 0;
        animate opacity { duration: 320ms; }

        Image {
            source: @image-url("../assets/icons/autumn-natter.svg");
            width: 64px;
            height: 64px;
            image-fit: contain;
            y: 0px;
            x: (parent.width - self.width) / 2;
        }
        Text {
            text: root.greeting;
            color: Theme.text-dim;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
            y: 84px;
            x: 60px;
            width: parent.width - 120px;
        }
        Text {
            text: "Every word stays on this machine.";
            color: Theme.text-dim;
            font-size: 11.5px;
            opacity: 0.75;
            y: 128px;
            x: 60px;
            width: parent.width - 120px;
            horizontal-alignment: center;
        }
    }

    // ------------------------------------------------------------------
    // The dock: the status line and the chat box. It sits in the middle of the
    // window while no chat is open, and slides down when a chat opens. Both
    // slides are smooth, because x, y and width are animated.
    dock := Rectangle {
        x: root.card-x;
        y: root.dock-y;
        width: root.card-width;
        height: root.dock-height;
        animate x { duration: 300ms; }
        animate y { duration: 420ms; easing: ease-out; }
        animate width { duration: 300ms; }

        // The two parts stand at the bottom of the dock. The bottom edge of the
        // chat box is therefore always 14px from the bottom of the window.
        VerticalLayout {
            spacing: 8px;
            alignment: end;

            // The status line. The two controls at its right end stand outside
            // the layout, pinned to the right edge of the row, so the row can
            // never hang past the chat box.
            Rectangle {
                height: root.status-height;
                vertical-stretch: 0;

                HorizontalLayout {
                    x: 0px;
                    y: 3px;
                    width: parent.width - 162px;
                    height: 24px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    // One dot for the state of the machine: bright while the
                    // model works, soft when all is still.
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        vertical-stretch: 0;
                        background: root.generating || root.server-busy
                            ? Theme.accent
                            : Theme.text-dim;
                        opacity: root.generating || root.server-busy ? 1 : 0.4;
                        animate background, opacity { duration: 220ms; }
                    }
                    Text {
                        text: status-text;
                        color: root.generating ? Theme.accent-strong : Theme.text-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    // The keys that matter are written next to the box. A
                    // narrow window drops the line, so nothing is crowded.
                    Text {
                        visible: !root.generating && !root.tight;
                        text: "Alt shows the chats";
                        color: Theme.text-dim;
                        font-size: 11px;
                        opacity: 0.8;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Text {
                        visible: root.generating;
                        text: "Escape stops the answer";
                        color: Theme.text-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }

                // A fresh chat. It is a small pill, so it is not mistaken for
                // the chat box. It stands at the right end of the status line.
                Rectangle {
                    visible: !root.generating;
                    x: parent.width - 150px;
                    y: 3px;
                    height: 26px;
                    width: new-lbl.preferred-width + 32px;
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: new-area.has-hover ? Theme.tint : Theme.surface;

                    Image {
                        source: @image-url("../assets/icons/plus.svg");
                        colorize: Theme.accent-strong;
                        width: 13px;
                        height: 13px;
                        x: 10px;
                        y: 7px;
                    }
                    new-lbl := Text {
                        text: "New chat";
                        color: Theme.accent-strong;
                        font-size: 12px;
                        x: 27px;
                        y: 0px;
                        vertical-alignment: center;
                    }
                    new-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.new-chat(); }
                    }
                }
                IconButton {
                    x: parent.width - 34px;
                    y: 0px;
                    icon: @image-url("../assets/icons/settings.svg");
                    tip: "Settings";
                    tip-left: true;
                    glyph: Theme.text;
                    base: Theme.surface;
                    width: 30px;
                    height: 30px;
                    clicked => { root.open-settings(); }
                }
            }

            // The chat box. Its height stands on its own, so the row with the
            // Code and Sandbox marks always sits well inside it.
            box := Rectangle {
                height: root.box-height;
                vertical-stretch: 0;
                border-radius: 14px;
                border-width: draft.has-focus ? 1.5px : 1px;
                border-color: draft.has-focus ? Theme.accent : Theme.line;
                background: Theme.surface;

                // Slint has no accept-return property, and a box for several
                // lines puts a new line when Enter comes. The keys therefore
                // stand on the text itself, where they are read before the text
                // handles them.
                draft := TextInput {
                    x: 16px;
                    y: 14px;
                    width: parent.width - 32px;
                    height: parent.height - 58px;
                    font-size: 13.5px;
                    color: Theme.text;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    single-line: false;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    text <=> root.draft-text;

                    key-pressed(event) => {
                        // The row of previews takes every key. The row has a
                        // scope of its own, and this is the fall back for the
                        // case where the box kept the keys.
                        if (root.overview) {
                            let letter = event.text.to-lowercase();
                            if (event.text == Key.Escape || event.text == Key.Alt) {
                                root.ask-overview(false);
                                return accept;
                            }
                            if (event.text == Key.LeftArrow || letter == "a") {
                                root.move-one(-1);
                                return accept;
                            }
                            if (event.text == Key.RightArrow || letter == "d") {
                                root.move-one(1);
                                return accept;
                            }
                            if (event.text == Key.Return) {
                                root.pick-middle();
                                return accept;
                            }
                            // Nothing else may reach the text of the box while
                            // the row stands in front.
                            return accept;
                        }
                        // Enter sends, and Shift and Enter is left to the text
                        // box, so it can add a line.
                        if (event.text == Key.Return) {
                            if (event.modifiers.shift) {
                                return reject;
                            }
                            if (root.generating) {
                                root.cancel-generation();
                            } else if (root.draft-text != "") {
                                root.send-message(root.draft-text);
                            }
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            if (root.generating) {
                                root.cancel-generation();
                                return accept;
                            }
                            return reject;
                        }
                        // Alt brings up the row of previews. The text box would
                        // otherwise keep the key.
                        if (event.text == Key.Alt) {
                            root.ask-overview(true);
                            return accept;
                        }
                        return reject;
                    }
                }

                // The hint. A text box has no hint of its own. It stays while
                // the box is empty, even when the box holds the keys, so the
                // box never looks like a blank hole.
                Text {
                    x: 16px;
                    y: 14px;
                    width: parent.width - 32px;
                    text: root.generating
                        ? "Wait for this answer, or press Escape to stop it."
                        : "Write a message. Enter sends it, and Shift and Enter starts a new line.";
                    color: Theme.text-dim;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    visible: root.draft-text == "";
                }

                // Badges in the lower left corner of the box.
                HorizontalLayout {
                    x: 10px;
                    y: parent.height - 38px;
                    spacing: 8px;

                    Badge {
                        text: "Code";
                        icon: @image-url("../assets/icons/code.svg");
                        active: code-enabled;
                        tip: "Let the model run one terminal command per step. Every command runs in the sandbox when the sandbox is on.";
                        clicked => { root.toggle-code(!code-enabled); }
                    }
                    Badge {
                        text: "Sandbox";
                        icon: @image-url("../assets/icons/shield.svg");
                        active: sandbox-enabled;
                        enabled: sandbox-available;
                        tip: sandbox-available
                            ? "Run every terminal command inside a bubblewrap sandbox. Inside a repository, the commands start in the repository directory."
                            : "bubblewrap (bwrap) was not found. Install it to sandbox the terminal tool.";
                        clicked => { root.toggle-sandbox(!sandbox-enabled); }
                    }
                    // The model has no thinking mode, so the badge says so
                    // and stays grey.
                    Badge {
                        text: thinking-available
                            ? "think: " + thinking-mode
                            : "No thinking modes";
                        icon: @image-url("../assets/icons/think.svg");
                        active: thinking-available && thinking-mode != "auto";
                        enabled: thinking-available;
                        tip: thinking-available
                            ? "The model can show its thinking. Click to change how much it thinks."
                            : "This model has no thinking mode.";
                        clicked => { root.cycle-thinking(); }
                    }
                }

                // Stop and send, in the lower right corner of the box. The mark
                // is dull while there is nothing to send, so it never promises
                // more than it can do.
                Rectangle {
                    property <bool> live: root.generating || root.draft-text != "";
                    width: 34px;
                    height: 34px;
                    x: parent.width - 46px;
                    y: parent.height - 46px;
                    visible: root.generating || root.send-visible;
                    border-radius: 17px;
                    background: root.generating
                        ? (send-area.has-hover ? Theme.accent-deep : Theme.accent-strong)
                        : (send-area.has-hover ? Theme.accent-warm : Theme.accent);
                    opacity: live ? 1 : 0.45;
                    animate opacity { duration: 180ms; }

                    Image {
                        source: generating
                            ? @image-url("../assets/icons/stop.svg")
                            : @image-url("../assets/icons/send.svg");
                        colorize: Theme.on-accent;
                        width: 16px;
                        height: 16px;
                        x: 9px;
                        y: 9px;
                    }

                    send-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if (generating) {
                                root.cancel-generation();
                            } else if (root.draft-text != "") {
                                root.send-message(root.draft-text);
                            }
                        }
                    }
                }
            }
        }
    }

    // This area only watches the pointer. When the pointer leaves the window,
    // the help bubble must go with it, because no control reports an exit then.
    // It stands below everything, so it takes no click and no focus.
    Rectangle {
        z: -1;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        TouchArea {
            // The area covers the whole window, so the loss of the hover means
            // the pointer left the window. Slint has no exit callback for a
            // TouchArea, so the hover flag is watched instead.
            changed has-hover => {
                if (!self.has-hover) {
                    TipLayer.wanted = false;
                    TipLayer.shown = false;
                }
            }
        }
    }

    // The help bubble sits on top of everything else in the window.
    ToolTipLayer {
        room-width: root.width;
        room-height: root.height;
    }
}
